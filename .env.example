# Copy to .env and edit. Never commit .env.
# All variables are optional; defaults follow the XDG layout (spec R3).
# Settings use the MM3_ prefix with "__" for nesting (MM3_<SECTION>__<FIELD>).
# Precedence: defaults < config.yaml < environment variables.
# Note: the app does not read .env itself; export these in your shell or use your process manager
# (for example `set -a; source .env; set +a`, or Docker Compose `env_file`).

# Where the app keeps its files
# MM3_CONFIG_DIR=~/.config/meetingmaster3
# MM3_DATA_DIR=~/.local/share/meetingmaster3
# MM3_CACHE_DIR=~/.cache/meetingmaster3
# MM3_MODELS_DIR=~/.cache/meetingmaster3/models

# Obsidian vault the app writes notes into
# MM3_VAULT__PATH=/path/to/your/vault

# Web server (binds localhost by default; see SECURITY.md before changing)
# MM3_SERVER__HOST=127.0.0.1
# MM3_SERVER__PORT=8765
# MM3_SERVER__ALLOWED_HOSTS=["mm3.lan"]

# Hugging Face token for the gated pyannote diarization models
# MM3_SECRETS__HF_TOKEN=

# Cloud LLM backends (optional; the default backend is local Ollama)
# MM3_SECRETS__OPENROUTER_API_KEY=
# MM3_SECRETS__OPENAI_API_KEY=
# MM3_SECRETS__AWS_ACCESS_KEY_ID=
# MM3_SECRETS__AWS_SECRET_ACCESS_KEY=

# Docker Compose only (docker/compose.yaml)
# MM3_VAULT_PATH=/path/to/your/vault   # host folder mounted at /vault (required)
# MM3_PORT=8765
# MM3_UID=1000
# MM3_GID=1000
# MM3_OLLAMA_URL=http://host.docker.internal:11434
